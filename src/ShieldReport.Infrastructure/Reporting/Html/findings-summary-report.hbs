{{!--
  ShieldReport built-in "Findings summary" template (ReportTemplateKind.FindingsSummary): the
  Findings Report export, Client → Asset → Vulnerability, for the filters chosen on that page.
  Same SELISE look as the engagement templates. Rendered with Handlebars.Net, then PDF via headless
  Chromium + paged.js (page numbers, running header, table of contents numbers).
  Variables are documented in FindingsSummaryRenderModel (Application/Reports/Rendering). Text from
  users goes through {{{text ...}}}, which HTML-escapes it — never insert user text with raw {{{x}}}.
  Scan-tool names are never part of the model.
--}}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>Findings Summary Report</title>
<style>
  @page {
    size: A4;
    margin: 24mm 18mm 20mm 18mm;
    @top-right { content: element(runningHeader); }
    {{!-- No user-supplied text inside CSS strings (a quote would break the stylesheet). --}}
    @bottom-left { content: "Confidential · Findings Summary Report"; font-size: 8pt; color: #777; }
    @bottom-right { content: "Page " counter(page) " of " counter(pages); font-size: 8pt; color: #777; }
  }
  @page cover { margin: 0; @top-right { content: none; } @bottom-left { content: none; } @bottom-right { content: none; } }

  body { font-family: "Calibri", "Carlito", "Liberation Sans", Arial, sans-serif; font-size: 10.5pt; line-height: 1.4; color: #222; }
  .running-header { position: running(runningHeader); }
  .running-header img { height: 28px; }

  .cover { page: cover; height: 296mm; overflow: hidden; background: #0b3d6b; color: #ffffff; break-after: page; page-break-after: always; }
  .cover img.photo { width: 100%; height: 140mm; object-fit: cover; display: block; }
  .cover .inner { padding: 14mm 18mm; }
  .cover .title { font-size: 30pt; font-weight: bold; margin: 0 0 3mm; color: #ffffff; }
  .cover .subtitle { font-size: 17pt; margin: 0 0 8mm; color: #ffffff; }
  .cover .meta { font-size: 11pt; margin: 0 0 1mm; color: #ffffff; }
  .cover .company { font-size: 9pt; margin-top: 18mm; color: #cfe0f1; }

  h1 { color: #0b5394; font-size: 16pt; border-bottom: 2px solid #0b5394; padding-bottom: 2mm; margin: 0 0 4mm; break-before: page; page-break-before: always; }
  h1.continue { break-before: auto; page-break-before: auto; margin-top: 8mm; }
  h2 { color: #0b5394; font-size: 13pt; margin: 6mm 0 2mm; }
  h3 { color: #1c4587; font-size: 11pt; margin: 4mm 0 1mm; }
  p { margin: 0 0 2.5mm; text-align: justify; }
  ul { margin: 0 0 2.5mm; padding-left: 6mm; }
  li { margin: 0 0 1mm; }
  table { border-collapse: collapse; width: 100%; margin: 2mm 0 4mm; }
  th, td { border: 1px solid #b7b7b7; padding: 4px 6px; text-align: left; vertical-align: top; font-size: 9.5pt; }
  th { background: #0b5394; color: #ffffff; font-weight: bold; }
  td.label { background: #dce6f1; font-weight: bold; width: 30%; }
  td.num, th.num { text-align: right; white-space: nowrap; }
  table.findings { table-layout: fixed; }
  table.findings td { font-size: 8.5pt; }
  table.findings .sev { white-space: nowrap; }
  table.findings td.endpoint { word-break: break-all; }
  thead { display: table-header-group; }
  .figure { text-align: center; margin: 3mm 0 4mm; break-inside: avoid; }
  .note { font-size: 9pt; color: #555555; }
  .warning { border: 1px solid #ffc000; background: #fff4d6; padding: 3mm; font-size: 9.5pt; margin: 0 0 4mm; }
  h2, h3 { break-after: avoid; page-break-after: avoid; }
  tr { break-inside: avoid; }
  .keep-together { break-inside: avoid; }

  .kpis { display: flex; gap: 3mm; margin: 2mm 0 5mm; }
  .kpi { flex: 1; border: 1px solid #b7b7b7; border-top: 3px solid #0b5394; padding: 2.5mm 3mm; }
  .kpi .value { font-size: 18pt; font-weight: bold; color: #0b3d6b; line-height: 1.1; }
  .kpi .caption { font-size: 8.5pt; color: #555555; }

  .sev { display: inline-block; padding: 0 5px; border-radius: 2px; font-size: 8pt; }
  .sev-Critical { background: #c00000; color: #ffffff; font-weight: bold; }
  .sev-High { background: #ff0000; color: #ffffff; font-weight: bold; }
  .sev-Medium { background: #ffc000; color: #222222; font-weight: bold; }
  .sev-Low { background: #00b050; color: #ffffff; font-weight: bold; }
  .sev-Informational { background: #5b9bd5; color: #ffffff; font-weight: bold; }

  .toc { list-style: none; padding-left: 0; }
  .toc li { margin: 1.2mm 0; }
  .toc li.sub { padding-left: 6mm; font-size: 10pt; }
  .toc li.subsub { padding-left: 12mm; font-size: 9.5pt; }
  .toc a { color: #222222; text-decoration: none; display: flex; }
  .toc a::after { content: target-counter(attr(href url), page); margin-left: auto; padding-left: 4mm; }
</style>
</head>
<body>

<!-- ============================ COVER ============================ -->
<section class="cover">
  <img class="photo" src="{{asset "cover.jpg"}}" alt="">
  <div class="inner">
    <p class="title">Findings Summary Report</p>
    <p class="subtitle">Tested assets and vulnerabilities</p>
    <p class="meta"><strong>{{Filters.Client}}</strong></p>
    <p class="meta">{{Filters.Period}}</p>
    <p class="meta">Generated {{formatDate GeneratedAt}}{{#if GeneratedBy}} by {{GeneratedBy}}{{/if}}</p>
    <p class="company">{{CompanyName}} · Secure Link Services BD Ltd · Midas Center, H-5, R-16, Dhanmondi, Dhaka-1209, Bangladesh · +88 02 9104556 · www.selise.ch</p>
  </div>
</section>

<div class="running-header"><img src="{{asset "logo.png"}}" alt="SELISE"></div>

<!-- ======================== TABLE OF CONTENTS ====================== -->
<h1 id="contents" class="continue">Table of Contents</h1>
<ul class="toc">
  <li><a href="#summary">Summary</a></li>
  <li><a href="#clients-overview">Clients Overview</a></li>
  <li><a href="#findings-by-asset">Findings by Client and Asset</a></li>
  {{#each Clients}}
  <li class="sub"><a href="#{{Anchor}}">{{Name}}</a></li>
  {{#each Assets}}<li class="subsub"><a href="#{{Anchor}}">{{Name}}</a></li>{{/each}}
  {{/each}}
  <li><a href="#annexure">Annexure</a></li>
</ul>

<!-- ============================ SUMMARY ============================ -->
<h1 id="summary">Summary</h1>
<p>This report summarises the assets tested by {{CompanyName}} and the vulnerabilities identified on them, for the following selection:</p>
<table>
  <tr><td class="label">Client</td><td>{{Filters.Client}}</td></tr>
  <tr><td class="label">Asset</td><td>{{Filters.Asset}}</td></tr>
  <tr><td class="label">Engagement</td><td>{{Filters.Engagement}}</td></tr>
  <tr><td class="label">Period</td><td>{{Filters.Period}}</td></tr>
  <tr><td class="label">Severity</td><td>{{Filters.Severity}}</td></tr>
  <tr><td class="label">Status</td><td>{{Filters.Status}}</td></tr>
  <tr><td class="label">Generated</td><td>{{formatDate GeneratedAt}}{{#if GeneratedBy}} by {{GeneratedBy}}{{/if}}</td></tr>
</table>

<div class="kpis">
  <div class="kpi"><div class="value">{{Summary.ClientCount}}</div><div class="caption">Clients</div></div>
  <div class="kpi"><div class="value">{{Summary.AssetsTested}}</div><div class="caption">Assets tested</div></div>
  <div class="kpi"><div class="value">{{Summary.TotalVulnerabilities}}</div><div class="caption">Vulnerabilities</div></div>
  <div class="kpi"><div class="value">{{Summary.OpenVulnerabilities}}</div><div class="caption">Open</div></div>
  <div class="kpi"><div class="value">{{Summary.ClosedVulnerabilities}}</div><div class="caption">Closed</div></div>
</div>

{{#if Truncated}}
<div class="warning">More than {{VulnerabilityLimit}} vulnerabilities match this selection. All counts and totals are complete, but the detailed tables list only the first {{VulnerabilityLimit}} vulnerabilities. Narrow the filters to include every row.</div>
{{/if}}

{{#if Counts.Total}}
<p>A total of {{Counts.Total}} vulnerabilities match this selection. The chart and table below break them down by severity.</p>
<div class="figure"><img src="{{SeverityChart}}" alt="Vulnerabilities by Severity" style="width:150mm"></div>
<table>
  <tr><th>Severity</th><th class="num">Vulnerabilities</th></tr>
  <tr><td><span class="sev sev-Critical">Critical</span></td><td class="num">{{Counts.Critical}}</td></tr>
  <tr><td><span class="sev sev-High">High</span></td><td class="num">{{Counts.High}}</td></tr>
  <tr><td><span class="sev sev-Medium">Medium</span></td><td class="num">{{Counts.Medium}}</td></tr>
  <tr><td><span class="sev sev-Low">Low</span></td><td class="num">{{Counts.Low}}</td></tr>
  <tr><td><span class="sev sev-Informational">Informational</span></td><td class="num">{{Counts.Informational}}</td></tr>
  <tr><td><strong>Total</strong></td><td class="num"><strong>{{Counts.Total}}</strong></td></tr>
</table>
{{else}}
<p>No vulnerabilities match this selection.</p>
{{/if}}

<!-- ======================== CLIENTS OVERVIEW ======================= -->
<h1 id="clients-overview">Clients Overview</h1>
<table>
  <thead>
  <tr><th>Client</th><th class="num">Assets tested</th><th class="num">Open</th><th class="num">Critical</th><th class="num">High</th><th class="num">Medium</th><th class="num">Low</th><th class="num">Info</th><th class="num">Total</th></tr>
  </thead>
  {{#each Clients}}
  <tr><td>{{Name}}</td><td class="num">{{AssetsTested}}</td><td class="num">{{OpenVulnerabilities}}</td><td class="num">{{Counts.Critical}}</td><td class="num">{{Counts.High}}</td><td class="num">{{Counts.Medium}}</td><td class="num">{{Counts.Low}}</td><td class="num">{{Counts.Informational}}</td><td class="num">{{Counts.Total}}</td></tr>
  {{else}}
  <tr><td colspan="9">No tested assets or vulnerabilities match this selection.</td></tr>
  {{/each}}
</table>

<!-- =================== FINDINGS BY CLIENT AND ASSET ================= -->
<h1 id="findings-by-asset">Findings by Client and Asset</h1>
{{#each Clients}}
<h2 id="{{Anchor}}">{{Name}}</h2>
<p class="note">{{AssetsTested}} asset(s) tested · {{OpenVulnerabilities}} open · {{Counts.Total}} vulnerabilities in total</p>
{{#each Assets}}
<div class="keep-together">
<h3 id="{{Anchor}}">{{Name}}</h3>
<p class="note">{{#if Identifier}}{{Identifier}} · {{/if}}{{#if AssetType}}{{AssetType}} · {{/if}}{{#if LastScannedAt}}last tested {{formatDate LastScannedAt}} · {{/if}}{{OpenVulnerabilities}} open of {{Counts.Total}}</p>
</div>
<table class="findings">
  <thead>
  <tr><th style="width:26%">Vulnerability</th><th style="width:13%">Severity</th><th class="num" style="width:7%">CVSS</th><th style="width:10%">Status</th><th style="width:21%">Endpoint</th><th style="width:12%">Engagement</th><th style="width:11%">First seen</th></tr>
  </thead>
  {{#each Vulnerabilities}}
  <tr>
    <td><strong>{{Id}}</strong> {{Title}}</td>
    <td><span class="sev sev-{{Severity}}">{{Severity}}</span></td>
    <td class="num">{{#if CvssScore}}{{CvssScore}}{{else}}—{{/if}}</td>
    <td>{{Status}}</td>
    <td class="endpoint">{{Endpoint}}</td>
    <td>{{#if Engagement}}{{Engagement}}{{else}}—{{/if}}</td>
    <td>{{formatDate FirstSeen}}</td>
  </tr>
  {{else}}
  <tr><td colspan="7">{{#if Counts.Total}}Vulnerability rows for this asset are beyond the listing limit.{{else}}No vulnerabilities match this selection on this asset.{{/if}}</td></tr>
  {{/each}}
</table>
{{/each}}
{{else}}
<p>No tested assets or vulnerabilities match this selection.</p>
{{/each}}

<!-- ============================ ANNEXURE =========================== -->
<h1 id="annexure">Annexure</h1>
<h2>Vulnerability Scoring</h2>
<p>Severities follow the Common Vulnerability Scoring System (CVSS) v3.1, a widely accepted standard for measuring the severity of security vulnerabilities based on exploitability and impact.</p>
<table>
  <tr><th>CVSS (v3.1) Score</th><th>Severity Level</th><th>Description</th></tr>
  <tr><td>0.0</td><td class="sev-Informational">Informational</td><td>No security risk, but may indicate misconfigurations, best practices, or system information leakage.</td></tr>
  <tr><td>0.1 – 3.9</td><td class="sev-Low">Low</td><td>Minimal impact; requires high privileges or user interaction.</td></tr>
  <tr><td>4.0 – 6.9</td><td class="sev-Medium">Medium</td><td>Potential data leakage or privilege escalation, limited scope.</td></tr>
  <tr><td>7.0 – 8.9</td><td class="sev-High">High</td><td>Unauthorized access, remote exploitation, or system compromise.</td></tr>
  <tr><td>9.0 – 10.0</td><td class="sev-Critical">Critical</td><td>Full system compromise, remote execution, or widespread impact.</td></tr>
</table>
<h2>Status Definitions</h2>
<table>
  <tr><td class="label">Open</td><td>Identified and not yet remediated.</td></tr>
  <tr><td class="label">In progress</td><td>Remediation has started.</td></tr>
  <tr><td class="label">Patched</td><td>Remediated.</td></tr>
  <tr><td class="label">Accepted risk</td><td>The client has accepted the risk.</td></tr>
  <tr><td class="label">Won't fix</td><td>Will not be remediated.</td></tr>
</table>

</body>
</html>
