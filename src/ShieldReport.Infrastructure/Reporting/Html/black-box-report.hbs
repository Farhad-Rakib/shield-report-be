    <p class="meta"><strong>{{Client.Name}}</strong></p>
    <p class="meta">{{Engagement.Title}}</p>
    <p class="meta">Version {{Report.Version}}.0 · {{formatDate Report.GeneratedAt}}{{#if Report.IsDraft}} · Draft{{/if}}</p>
    <p class="company">{{CompanyName}} · Secure Link Services BD Ltd · Midas Center, H-5, R-16, Dhanmondi, Dhaka-1209, Bangladesh · +88 02 9104556 · www.selise.ch</p>
  </div>
</section>

<div class="running-header"><img src="{{asset "logo.png"}}" alt="SELISE" data-word-width="110"></div>

