{{!--
  ShieldReport built-in Black Box report template, converted from the SELISE "Black Box Testing.docx"
  sample (the White, Gray and Black Box templates are separate files with their own sections and
  wording). Rendered with Handlebars.Net, then:
    PDF  — headless Chromium + paged.js (page numbers, running header, table of contents numbers)
    Word — CSS inlined (PreMailer) and converted with HtmlToOpenXml onto the template .docx (styles,
           header/footer); the [data-word-toc] list becomes a real Word TOC field.
  Variables are documented in ReportRenderModel (Application/Reports/Rendering). Text from users or
  the LLM goes through {{{text ...}}}, which HTML-escapes it — never insert user text with raw {{{x}}}.
  TestingType / IsWhite / IsGray / IsBlack still hold the engagement's testing type, but this
  template's wording is fixed to Black Box testing.
--}}
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>Security Assessment Report — {{Client.Name}}</title>
<style>
  @page {
    size: A4;
    margin: 24mm 18mm 20mm 18mm;
    @top-right { content: element(runningHeader); }
    {{!-- No user-supplied text inside CSS strings (a quote would break the stylesheet). --}}
    @bottom-left { content: "Confidential · Security Assessment Report v{{Report.Version}}{{#if Report.IsDraft}} · DRAFT{{/if}}"; font-size: 8pt; color: #777; }
    @bottom-right { content: "Page " counter(page) " of " counter(pages); font-size: 8pt; color: #777; }
  }
  @page cover { margin: 0; @top-right { content: none; } @bottom-left { content: none; } @bottom-right { content: none; } }

  body { font-family: "Calibri", "Carlito", "Liberation Sans", Arial, sans-serif; font-size: 10.5pt; line-height: 1.4; color: #222; }
  .running-header { position: running(runningHeader); }
  .running-header img { height: 28px; }

  .cover { page: cover; height: 296mm; overflow: hidden; background: #0b3d6b; color: #ffffff; break-after: page; page-break-after: always; }
  .cover img.photo { width: 100%; height: 140mm; object-fit: cover; display: block; }
  .cover .inner { padding: 14mm 18mm; }
  .cover .title { font-size: 30pt; font-weight: bold; margin: 0 0 3mm; color: #ffffff; }
  .cover .subtitle { font-size: 17pt; margin: 0 0 8mm; color: #ffffff; }
  .cover .meta { font-size: 11pt; margin: 0 0 1mm; color: #ffffff; }
  .cover .company { font-size: 9pt; margin-top: 18mm; color: #cfe0f1; }

  h1 { color: #0b5394; font-size: 16pt; border-bottom: 2px solid #0b5394; padding-bottom: 2mm; margin: 0 0 4mm; break-before: page; page-break-before: always; }
  h1.continue { break-before: auto; page-break-before: auto; margin-top: 8mm; }
  h2 { color: #0b5394; font-size: 13pt; margin: 6mm 0 2mm; }
  h3 { color: #1c4587; font-size: 11pt; margin: 4mm 0 1mm; }
  h4 { color: #333333; font-size: 10.5pt; margin: 3mm 0 1mm; }
  p { margin: 0 0 2.5mm; text-align: justify; }
  ul { margin: 0 0 2.5mm; padding-left: 6mm; }
  li { margin: 0 0 1mm; }
  table { border-collapse: collapse; width: 100%; margin: 2mm 0 4mm; }
  th, td { border: 1px solid #b7b7b7; padding: 4px 6px; text-align: left; vertical-align: top; font-size: 9.5pt; }
  th { background: #0b5394; color: #ffffff; font-weight: bold; }
  td.label { background: #dce6f1; font-weight: bold; width: 30%; }
  .figure { text-align: center; margin: 3mm 0 4mm; break-inside: avoid; }
  .figure img { max-height: 200mm; object-fit: contain; }
  .caption { font-size: 8.5pt; color: #666666; text-align: center; margin-top: 1mm; }
  .note { font-size: 9pt; color: #555555; }
  pre, .code { font-family: "Consolas", "Courier New", monospace; font-size: 8.5pt; background: #f3f3f3; padding: 3mm; white-space: pre-wrap; word-break: break-all; }
  .finding { break-inside: auto; }
  h2, h3, h4 { break-after: avoid; page-break-after: avoid; }
  tr { break-inside: avoid; }
  .keep-together { break-inside: avoid; }
  .finding h2 { break-after: avoid; page-break-after: avoid; }

  .sev-Critical { background: #c00000; color: #ffffff; font-weight: bold; }
  .sev-High { background: #ff0000; color: #ffffff; font-weight: bold; }
  .sev-Medium { background: #ffc000; color: #222222; font-weight: bold; }
  .sev-Low { background: #00b050; color: #ffffff; font-weight: bold; }
  .sev-Informational { background: #5b9bd5; color: #ffffff; font-weight: bold; }

  .toc { list-style: none; padding-left: 0; }
  .toc li { margin: 1.2mm 0; }
  .toc li.sub { padding-left: 6mm; font-size: 10pt; }
  .toc a { color: #222222; text-decoration: none; display: flex; }
  .toc a::after { content: target-counter(attr(href url), page); margin-left: auto; padding-left: 4mm; }

  .offices td { border: none; padding: 2px 6px 6px 0; font-size: 8.5pt; color: #444444; width: 33%; }
  .offices .city { font-weight: bold; color: #0b5394; }
</style>
</head>
<body>

