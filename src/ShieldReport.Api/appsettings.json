{
  "DataAccess": {
    "Orm": "efcore"
  },
  "Database": {
    "Provider": "sqlserver"
  },
  "ConnectionStrings": {
    "PostgresConnection": "Host=localhost;Port=5432;Database=ShieldReportDb;Username=postgres;Password=postgres",
    "SqlServerConnection": "Server=localhost,1433;Database=ShieldReportDb;User Id=sa;Password=Mssql@12345Strong;TrustServerCertificate=True;"
  },
  // Requests per fixed one-minute window. PerUserPerMinute applies per signed-in user;
  // AnonymousPerMinute applies per client IP to unauthenticated calls (login, refresh, public
  // settings) and is what throttles password guessing, so keep it low.
  // Override in Docker with RateLimiting__PerUserPerMinute / RateLimiting__AnonymousPerMinute.
  "RateLimiting": {
    "PerUserPerMinute": 600,
    "AnonymousPerMinute": 30
  },
  "Caching": {
    "PermissionsTtlMinutes": 30,
    "MenusTtlMinutes": 30,
    "RolesTtlMinutes": 30,
    "RolePermissionsTtlMinutes": 30
  },
  "Jwt": {
    "Issuer": "ShieldReport",
    "Audience": "ShieldReport.Client",
    "SecretKey": "CHANGE_THIS_TO_A_STRONG_SECRET_KEY_WITH_AT_LEAST_32_CHARACTERS",
    "ExpiryMinutes": 60,
    "RefreshTokenExpiryDays": 7
  },
  "Scanning": {
    "ReconftwOutputVolume": "shieldreport-scan-output",
    "ReconftwOutputPath": "/app/scan-output",
    "Tools": {
      "Naabu": { "PidsLimit": 256 },
      "Nuclei": { "PidsLimit": 512 },
      "Reconftw": { "Image": "shieldreport/reconftw-lean:latest", "PidsLimit": 1024 }
    }
  },
  "Frontend": {
    "BaseUrl": "http://localhost:5173"
  },
  "Smtp": {
    // Fallback only: outgoing mail is configured in the app (Administration -> Email Configuration).
    "Host": "",
    "Port": 587,
    "Username": "",
    "Password": "",
    "FromAddress": "",
    "FromName": "ShieldReport",
    "UseSsl": true
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.AspNetCore.Diagnostics.ExceptionHandlerMiddleware": "Fatal",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "Enrich": [ "FromLogContext" ],
    "Properties": {
      "Application": "ShieldReport.Api"
    },
    "EnableSeq": false,
    "SeqServerUrl": "http://localhost:5341"
  },
  "AllowedHosts": "*"
}
