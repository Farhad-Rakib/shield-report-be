# Copy to .env (same folder as docker-compose.yml) and fill in before `docker compose up -d --build`.
# .env holds secrets: it is git-ignored, keep it that way. Use long random values in production,
# e.g. `openssl rand -base64 48`.
#
# This compose file expects shield-report-fe cloned as a sibling directory next to this repo.

# ---- Public address -------------------------------------------------------------------------
# SITE_ADDRESS tells the Caddy proxy how to serve the app:
#   shieldreport.example.com   automatic Let's Encrypt HTTPS (DNS A record -> this server, ports 80+443 open)
#   https://192.168.1.50       HTTPS with Caddy's internal CA (browser warning until trusted)
#   http://192.168.1.50        plain HTTP, LAN demo only
SITE_ADDRESS=http://192.168.1.50
# The URL people type into the browser — used in invite/password-reset email links.
PUBLIC_URL=http://192.168.1.50
# Set to true whenever PUBLIC_URL starts with https:// (refresh-token cookie needs it).
COOKIES_REQUIRE_SECURE=false

# Host ports for the proxy (the only published ports). API_PORT is a localhost-only debug port.
HTTP_PORT=80
HTTPS_PORT=443
API_PORT=5050

# ---- Secrets ----------------------------------------------------------------------------------
# SQL Server "sa" password: 8+ chars with upper, lower, digit and symbol.
MSSQL_SA_PASSWORD=Str0ng!ChangeMe2026
# JWT signing key: at least 32 characters, unique per environment.
JWT_SECRET_KEY=change-me-to-a-long-random-value-at-least-32-chars

# ---- SQL Server -------------------------------------------------------------------------------
# Express is free for production (10 GB per database). Use Standard/Enterprise only if licensed.
MSSQL_PID=Express
MSSQL_MEMORY_LIMIT_MB=2048

# ---- Email ------------------------------------------------------------------------------------
# Defaults point at the Mailhog sink (UI on http://127.0.0.1:8025 on the server). For real email,
# set your provider here.
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USERNAME=demo
SMTP_PASSWORD=demo
SMTP_USE_SSL=false
SMTP_FROM_ADDRESS=no-reply@shieldreport.local
SMTP_FROM_NAME=Shield Report

# ---- Backups ----------------------------------------------------------------------------------
BACKUP_HOUR_UTC=2
BACKUP_RETENTION_DAYS=14
BACKUP_ON_START=true

# ---- App --------------------------------------------------------------------------------------
# Production hides Swagger. Development exposes it at <PUBLIC_URL>/swagger (via the debug port).
ASPNETCORE_ENVIRONMENT=Production
# API rate limits (requests per one-minute window). Per signed-in user, and per client IP for
# anonymous calls such as login: keep the anonymous one low, it throttles password guessing.
RATE_LIMIT_PER_USER_PER_MINUTE=600
RATE_LIMIT_ANONYMOUS_PER_MINUTE=30

# ---- Pinned images (upgrade deliberately: change, back up, `docker compose up -d`) -------------
# MSSQL_IMAGE=mcr.microsoft.com/mssql/server@sha256:e07b9699a2b749969f19d86563ceeea22bd3a69f7f1db85a8d1ac4bdaf0c6f56
# NAABU_IMAGE=projectdiscovery/naabu@sha256:0b7efcd6eb4bf7be2c5cfb2bbfe091a132df0e442e549267bca818a4cef15ea4
# NUCLEI_IMAGE=projectdiscovery/nuclei@sha256:66b5f88c9b98ad29c03343dd34e5e85bde0ad10428d72e0171b067efe1ed7811
# CADDY_IMAGE=caddy:2.8.4-alpine
